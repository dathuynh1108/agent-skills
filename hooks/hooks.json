{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/ai-memory\" hook --event session-start --agent codex --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/ai-memory\" hook --event user-prompt-submit --agent codex --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/ai-memory\" hook --event pre-tool-use --agent codex --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/ai-memory\" hook --event post-tool-use --agent codex --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/ai-memory\" hook --event pre-compact --agent codex --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/ai-memory\" hook --event stop --agent codex --server-url http://127.0.0.1:49374 --project-strategy repo-root",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/sh -lc 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); cd \"$root\" || exit 0; printf \"\\n[Codex scope guard]\\nrepo: %s\\n\" \"$root\"; printf \"branch: \"; git branch --show-current 2>/dev/null || true; if [ -f .gitnexus/run.cjs ]; then node .gitnexus/run.cjs status || true; fi; printf \"changed files:\\n\"; git status --short; git diff --check || true'",
            "timeout": 30,
            "statusMessage": "Checking repo scope before final response"
          }
        ]
      }
    ]
  }
}
